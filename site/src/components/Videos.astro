---
/**
 * Videos — "Videos" section: a responsive grid of YouTube video thumbnails tagged by
 * technology area. Config: `video.json`. Each item only provides a YouTube `url`, `title` and
 * `technology`; the thumbnail image and the watch link are both derived from the URL at build
 * time (see `utils/youtube.ts`), so there is no separate thumbnail field to keep in sync.
 */
import type { VideosConfig } from '../types/config';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { getYouTubeThumbnail } from '../utils/youtube';
import { linkAttrs, resolveUrl } from '../utils/url';

interface Props {
  config: VideosConfig;
}

const { config } = Astro.props;
---

<section class="section container" id={config.heading.id} aria-labelledby={`${config.heading.id}-title`}>
  <SectionHeader heading={config.heading} />
  <ul class="video-grid">
    {
      config.items.map((item) => {
        const thumbnail = getYouTubeThumbnail(item.url);
        if (!thumbnail) console.warn(`[Videos] Could not derive a thumbnail from URL "${item.url}" (video "${item.title}").`);
        return (
          <li class={`accent-${item.accent}`}>
            <a class="card card-interactive video-card" href={resolveUrl(item.url)} {...linkAttrs(item.url)}>
              <span class="video-thumb">
                {thumbnail ? (
                  <img src={thumbnail} alt="" width="480" height="270" loading="lazy" />
                ) : (
                  <span class="video-thumb-fallback" aria-hidden="true">
                    <Icon name="video" size={28} />
                  </span>
                )}
                <span class="video-play" aria-hidden="true">
                  <Icon name="play-circle" size={34} />
                </span>
              </span>
              <span class="video-body">
                <span class="badge">{item.technology}</span>
                <span class="video-title">{item.title}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .video-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    color: var(--text);
  }
  .video-card:hover {
    color: var(--text);
  }
  .video-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--surface-alt);
  }
  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-thumb-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--text-muted);
  }
  .video-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
  }
  .video-play :global(.icon) {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.55));
    border-radius: 50%;
    background: rgba(17, 24, 39, 0.45);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .video-card:hover .video-play :global(.icon) {
    transform: scale(1.08);
    background: rgba(17, 24, 39, 0.65);
  }
  .video-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 1rem 1.1rem;
  }
  .video-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }
</style>
