---
/**
 * Videos — "Videos" section: a responsive grid of YouTube video thumbnails tagged by
 * technology area. Config: `video.json`. Each item only provides a YouTube `url`, `title`,
 * `technology` and an optional `kind` ("video" by default, or "playlist"); the thumbnail image
 * and the watch link are both derived from the URL at build time (see `utils/youtube.ts`), so
 * there is no separate thumbnail field to keep in sync. Playlists get a "Playlist" badge over the
 * bottom-right of the thumbnail instead of a plain play button, so visitors can tell them apart
 * at a glance (see §6.6 of docs/ARCHITECTURE.md).
 */
import type { VideosConfig } from '../types/config';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { getYouTubePlaylistId, getYouTubeThumbnail } from '../utils/youtube';
import { linkAttrs, resolveUrl } from '../utils/url';

interface Props {
  config: VideosConfig;
}

const { config } = Astro.props;
---

<section class="section container" id={config.heading.id} aria-labelledby={`${config.heading.id}-title`}>
  <SectionHeader heading={config.heading} />
  <ul class="video-grid">
    {
      config.items.map((item) => {
        const isPlaylist = item.kind === 'playlist';
        if (isPlaylist && !getYouTubePlaylistId(item.url)) {
          console.warn(`[Videos] "${item.title}" is marked "kind": "playlist" but its URL has no "list=" parameter: ${item.url}`);
        }
        const thumbnail = getYouTubeThumbnail(item.url);
        if (!thumbnail) {
          const hint = isPlaylist
            ? ' For playlists, use a "watch?v=...&list=..." URL to a representative video so a thumbnail can be derived.'
            : '';
          console.warn(`[Videos] Could not derive a thumbnail from URL "${item.url}" (video "${item.title}").${hint}`);
        }
        return (
          <li class={`accent-${item.accent}`} data-kind={item.kind}>
            <a class="card card-interactive video-card" href={resolveUrl(item.url)} {...linkAttrs(item.url)}>
              <span class="video-thumb">
                {thumbnail ? (
                  <img src={thumbnail} alt="" width="480" height="270" loading="lazy" />
                ) : (
                  <span class="video-thumb-fallback" aria-hidden="true">
                    <Icon name={isPlaylist ? 'collection' : 'video'} size={28} />
                  </span>
                )}
                <span class="video-play" aria-hidden="true">
                  <Icon name="play-circle" size={34} />
                </span>
                {
                  isPlaylist && (
                    <span class="video-playlist-badge">
                      <Icon name="collection" size={13} />
                      Playlist
                    </span>
                  )
                }
              </span>
              <span class="video-body">
                <span class="badge">{item.technology}</span>
                <span class="video-title">{item.title}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .video-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    color: var(--text);
  }
  .video-card:hover {
    color: var(--text);
  }

  .video-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--surface-alt);
  }
  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-thumb-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--text-muted);
  }
  .video-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
  }
  .video-play :global(.icon) {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.55));
    border-radius: 50%;
    background: rgba(17, 24, 39, 0.45);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .video-card:hover .video-play :global(.icon) {
    transform: scale(1.08);
    background: rgba(17, 24, 39, 0.65);
  }
  .video-playlist-badge {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: rgba(17, 24, 39, 0.78);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .video-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 1rem 1.1rem;
  }
  .video-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }
</style>
