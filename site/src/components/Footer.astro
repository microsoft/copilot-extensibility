---
/**
 * Footer — site footer.
 * Config: `navigation.json` → `footer` section (the same file that configures the Header).
 *
 * Layout: brand + tagline + social icons, link columns and a "communities" column.
 */
import type { FooterConfig } from '../types/config';
import Icon from './Icon.astro';
import { linkAttrs, resolveUrl } from '../utils/url';

interface Props {
  config: FooterConfig;
}

const { config } = Astro.props;
const { brand, social, columns, communities } = config;
---

<footer class="site-footer">
  <div class="container footer-main" style={{ '--cols': columns.length }}>
    <div class="footer-brand">
      <a class="brand" href={resolveUrl(brand.url)}>
        <img src={resolveUrl(brand.logo)} alt="" width="26" height="26" />
        <span>{brand.name}</span>
      </a>
      <p>{brand.tagline}</p>
      <ul class="social">
        {
          social.map((s) => (
            <li>
              <a href={resolveUrl(s.url)} aria-label={s.label} title={s.label} {...linkAttrs(s.url)}>
                <Icon name={s.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      columns.map((column) => (
        <nav class="footer-col" aria-label={column.title}>
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={resolveUrl(link.url)} {...linkAttrs(link.url, link.external)}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <nav class="footer-col footer-communities" aria-label={communities.title}>
      <h2>{communities.title}</h2>
      <ul>
        {
          communities.links.map((link) => (
            <li>
              <a class="link-arrow" href={resolveUrl(link.url)} {...linkAttrs(link.url, link.external)}>
                {link.label}
                <Icon name="arrow-right" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container visitor-counter">
    <img src="https://m365-visitor-stats.azurewebsites.net/Copilot-Extensibility" alt="Visitors Counter" />
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 2rem;
    background: var(--chrome-bg);
    color: var(--chrome-muted);
    font-size: 0.85rem;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1.6fr repeat(var(--cols, 3), 1fr) 1.6fr;
    gap: 2rem;
    padding-block: 2.5rem 2rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--chrome-text);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .footer-brand p {
    max-width: 18rem;
    margin: 0.75rem 0 1rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social {
    display: flex;
    gap: 0.5rem;
  }
  .social a {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--chrome-muted);
  }
  .social a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  h2 {
    margin: 0 0 0.75rem;
    color: var(--chrome-text);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .footer-col li + li {
    margin-top: 0.4rem;
  }
  .footer-col a {
    color: var(--chrome-muted);
  }
  .footer-col a:hover {
    color: #fff;
  }
  .footer-communities .link-arrow {
    font-weight: 500;
    font-size: 0.85rem;
  }
  .visitor-counter {
    display: flex;
    justify-content: center;
    padding-bottom: 1rem;
  }

  @media (max-width: 960px) {
    .footer-main {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer-brand,
    .footer-communities {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
