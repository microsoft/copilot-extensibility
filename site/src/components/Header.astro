---
/**
 * Header — top navigation bar.
 * Config: `navigation.json` → `header` section.
 *
 * Features: brand, nav links with optional dropdowns (`children`), client-side search over
 * the site content (with a configurable external fallback), light/dark theme toggle,
 * icon actions (e.g. GitHub) and a responsive mobile menu.
 */
import type { HeaderConfig } from '../types/config';
import type { SearchEntry } from '../utils/search';
import Icon from './Icon.astro';
import { linkAttrs, resolveUrl } from '../utils/url';

interface Props {
  config: HeaderConfig;
  /** Entries searchable from the header search box (see `utils/search.ts`). */
  searchIndex?: SearchEntry[];
}

const { config, searchIndex = [] } = Astro.props;
const { brand, items, search, themeToggle, actions } = config;
const serializedIndex = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={resolveUrl(brand.url)}>
      <img src={resolveUrl(brand.logo)} alt="" width="28" height="28" />
      <span>{brand.name}</span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          items.map((item, index) =>
            item.children?.length ? (
              <li class="nav-item has-children">
                <button
                  class="nav-link nav-trigger"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-menu-${index}`}
                >
                  {item.label}
                  <Icon name="chevron-down" size={14} />
                </button>
                <ul class="dropdown" id={`nav-menu-${index}`}>
                  {item.children.map((child) => (
                    <li>
                      <a href={resolveUrl(child.url)} {...linkAttrs(child.url, child.external)}>
                        <span class="dropdown-label">{child.label}</span>
                        {child.description && <span class="dropdown-desc">{child.description}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav-item">
                <a class="nav-link" href={resolveUrl(item.url ?? '#')} {...linkAttrs(item.url ?? '#', item.external)}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="header-tools">
      {
        search.enabled && (
          <div class="search" data-fallback-url={search.fallbackUrl} data-fallback-label={search.fallbackLabel}>
            <label class="sr-only" for="site-search">
              {search.placeholder}
            </label>
            <Icon name="search" size={16} class="search-icon" />
            <input
              id="site-search"
              type="search"
              placeholder={search.placeholder}
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="search-results"
              aria-autocomplete="list"
            />
            <kbd class="search-kbd" aria-hidden="true">/</kbd>
            <ul class="search-results" id="search-results" role="listbox" hidden />
            <script type="application/json" id="search-index" set:html={serializedIndex} />
          </div>
        )
      }

      {
        themeToggle.enabled && (
          <button class="icon-button theme-toggle" type="button" aria-label="Toggle dark mode">
            <Icon name="sun" size={18} class="theme-icon-light" />
            <Icon name="moon" size={18} class="theme-icon-dark" />
          </button>
        )
      }

      {
        actions.map((action) => (
          <a class="icon-button" href={resolveUrl(action.url)} aria-label={action.label} title={action.label} {...linkAttrs(action.url)}>
            <Icon name={action.icon} size={20} />
          </a>
        ))
      }

      <button class="icon-button menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
        <Icon name="menu" size={20} class="menu-icon-open" />
        <Icon name="close" size={20} class="menu-icon-close" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--chrome-bg) 92%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--chrome-border);
    color: var(--chrome-text);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--chrome-text);
    font-weight: 700;
    font-size: 1.1rem;
    white-space: nowrap;
  }
  .brand:hover {
    color: #fff;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-item {
    position: relative;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--chrome-text);
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .nav-link:hover,
  .nav-trigger[aria-expanded='true'] {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .nav-trigger[aria-expanded='true'] :global(.icon) {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 280px;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }
  .nav-trigger[aria-expanded='true'] + .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .dropdown a {
    display: flex;
    flex-direction: column;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    color: var(--text);
  }
  .dropdown a:hover {
    background: var(--accent-indigo-soft);
  }
  .dropdown-label {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .dropdown-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search :global(.search-icon) {
    position: absolute;
    left: 0.75rem;
    color: var(--chrome-muted);
    pointer-events: none;
  }
  .search input {
    width: 230px;
    height: 38px;
    padding: 0 2rem 0 2.25rem;
    border: 1px solid var(--chrome-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--chrome-text);
    font: inherit;
    font-size: 0.88rem;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .search input::placeholder {
    color: var(--chrome-muted);
  }
  .search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }
  .search input:focus {
    outline: none;
    border-color: rgba(165, 180, 252, 0.7);
    background: rgba(255, 255, 255, 0.1);
  }
  .search-kbd {
    position: absolute;
    right: 0.7rem;
    padding: 0 0.35rem;
    border: 1px solid var(--chrome-border);
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.7rem;
    color: var(--chrome-muted);
    pointer-events: none;
  }
  .search input:focus ~ .search-kbd {
    display: none;
  }
  .search-results {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: min(420px, calc(100vw - 2rem));
    max-height: 70vh;
    overflow: auto;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    color: var(--text);
  }
  .search-results :global(a) {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    color: var(--text);
  }
  .search-results :global(a:hover),
  .search-results :global(a[aria-selected='true']) {
    background: var(--accent-indigo-soft);
  }
  .search-results :global(.result-title) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .search-results :global(.result-cat) {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-indigo);
  }
  .search-results :global(.result-desc) {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-results :global(.result-empty) {
    padding: 0.6rem 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .icon-button {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--chrome-text);
    cursor: pointer;
  }
  .icon-button:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .theme-toggle :global(.theme-icon-dark),
  :global([data-theme='dark']) .theme-toggle :global(.theme-icon-light) {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle :global(.theme-icon-dark) {
    display: block;
  }

  .menu-toggle {
    display: none;
  }
  .menu-toggle :global(.menu-icon-close),
  .menu-toggle[aria-expanded='true'] :global(.menu-icon-open) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.menu-icon-close) {
    display: block;
  }

  @media (max-width: 1080px) {
    .search input {
      width: 180px;
    }
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: inline-grid;
    }
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 0.75rem 1.5rem 1.25rem;
      background: var(--chrome-bg);
      border-bottom: 1px solid var(--chrome-border);
    }
    .nav.is-open {
      display: block;
    }
    .nav-list {
      flex-direction: column;
      align-items: stretch;
    }
    .nav-link {
      width: 100%;
      justify-content: space-between;
      padding: 0.75rem;
    }
    .dropdown {
      position: static;
      display: none;
      min-width: 0;
      margin: 0.25rem 0 0.5rem;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav-trigger[aria-expanded='true'] + .dropdown {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 0.5rem 0.25rem;
      padding-block: 0.6rem;
    }
    .brand {
      font-size: 1rem;
    }
    .header-tools {
      display: contents;
    }
    .search {
      order: 10;
      flex-basis: 100%;
    }
    .search input {
      width: 100%;
    }
    .theme-toggle {
      margin-left: auto;
    }
    .search-kbd {
      display: none;
    }
  }
</style>

<script>
  // ---- Dropdown menus -------------------------------------------------------
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.site-header .nav-trigger'));
  const closeAllDropdowns = (except?: HTMLButtonElement) =>
    triggers.forEach((t) => t !== except && t.setAttribute('aria-expanded', 'false'));

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = trigger.getAttribute('aria-expanded') === 'true';
      closeAllDropdowns(trigger);
      trigger.setAttribute('aria-expanded', String(!open));
    });
  });
  document.addEventListener('click', () => closeAllDropdowns());

  // ---- Mobile menu ----------------------------------------------------------
  const menuToggle = document.querySelector<HTMLButtonElement>('.site-header .menu-toggle');
  const nav = document.getElementById('primary-nav');
  const setMenu = (open: boolean) => {
    menuToggle?.setAttribute('aria-expanded', String(open));
    menuToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
  };
  menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // ---- Theme toggle ---------------------------------------------------------
  document.querySelector('.site-header .theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable (private mode) */
    }
  });

  // ---- Search ---------------------------------------------------------------
  interface Entry {
    title: string;
    description: string;
    category: string;
    url: string;
  }

  const container = document.querySelector<HTMLElement>('.site-header .search');
  const input = document.getElementById('site-search') as HTMLInputElement | null;
  const list = document.getElementById('search-results') as HTMLUListElement | null;

  if (container && input && list) {
    const entries: Entry[] = JSON.parse(document.getElementById('search-index')?.textContent || '[]');
    const fallbackUrl = container.dataset.fallbackUrl;
    const fallbackLabel = container.dataset.fallbackLabel || 'Search the web for';
    let active = -1;

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const isExternal = (url: string) => /^(https?:)?\/\//i.test(url);

    const close = () => {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };

    const links = () => Array.from(list.querySelectorAll<HTMLAnchorElement>('a'));

    const highlight = (index: number) => {
      const all = links();
      if (!all.length) return;
      active = (index + all.length) % all.length;
      all.forEach((a, i) => a.setAttribute('aria-selected', String(i === active)));
      all[active].scrollIntoView({ block: 'nearest' });
    };

    const render = () => {
      const query = input.value.trim().toLowerCase();
      if (!query) return close();

      const terms = query.split(/\s+/);
      const results = entries
        .map((e) => {
          const title = e.title.toLowerCase();
          const haystack = `${title} ${e.description.toLowerCase()} ${e.category.toLowerCase()}`;
          if (!terms.every((t) => haystack.includes(t))) return null;
          const score = (title.startsWith(query) ? 3 : 0) + (title.includes(query) ? 2 : 0);
          return { e, score };
        })
        .filter((r): r is { e: Entry; score: number } => r !== null)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);

      const target = (url: string) => (isExternal(url) ? ' target="_blank" rel="noopener noreferrer"' : '');
      let html = results
        .map(
          ({ e }) => `<li role="presentation"><a role="option" href="${escapeHtml(e.url)}"${target(e.url)}>
            <span class="result-title"><span>${escapeHtml(e.title)}</span><span class="result-cat">${escapeHtml(e.category)}</span></span>
            <span class="result-desc">${escapeHtml(e.description)}</span></a></li>`,
        )
        .join('');

      if (!results.length) html = `<li class="result-empty" role="presentation">No results on this site.</li>`;
      if (fallbackUrl) {
        const url = fallbackUrl.replace('{query}', encodeURIComponent(input.value.trim()));
        html += `<li role="presentation"><a role="option" href="${escapeHtml(url)}"${target(url)}>
          <span class="result-title"><span>${escapeHtml(fallbackLabel)} “${escapeHtml(input.value.trim())}”</span></span></a></li>`;
      }

      list.innerHTML = html;
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    };

    input.addEventListener('input', render);
    input.addEventListener('focus', () => input.value && render());
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        highlight(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        highlight(active - 1);
      } else if (event.key === 'Enter') {
        const target = links()[active >= 0 ? active : 0];
        if (target) {
          event.preventDefault();
          target.click();
        }
      } else if (event.key === 'Escape') {
        close();
        input.blur();
      }
    });
    list.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) close();
    });
    document.addEventListener('click', (event) => {
      if (!container.contains(event.target as Node)) close();
    });
    document.addEventListener('keydown', (event) => {
      const tag = (event.target as HTMLElement).tagName;
      if (event.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(tag)) {
        event.preventDefault();
        input.focus();
      }
    });
  }
</script>
