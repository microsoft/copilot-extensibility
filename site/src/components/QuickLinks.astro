---
/**
 * QuickLinks — the four entry-point cards (Learn, Build, Technologies, Community)
 * that overlap the bottom edge of the hero.
 * Config: `quick-links.json`.
 */
import type { QuickLinksConfig } from '../types/config';
import Icon from './Icon.astro';
import { linkAttrs, resolveUrl } from '../utils/url';

interface Props {
  config: QuickLinksConfig;
}

const { config } = Astro.props;
---

<nav class="container quick-links" aria-label="Quick links">
  <ul class="card">
    {
      config.items.map((item) => (
        <li class={`accent-${item.accent}`}>
          <a href={resolveUrl(item.link.url)} {...linkAttrs(item.link.url, item.link.external)}>
            <span class="icon-tile">
              <Icon name={item.icon} size={24} />
            </span>
            <span class="ql-body">
              <span class="ql-title">{item.title}</span>
              <span class="ql-desc">{item.description}</span>
              <span class="link-arrow ql-cta">
                {item.link.label}
                <Icon name="arrow-right" size={14} />
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .quick-links {
    position: relative;
    z-index: 2;
    margin-top: -4.25rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    box-shadow: var(--shadow-md);
  }
  li + li {
    border-left: 1px solid var(--border);
  }
  a {
    display: flex;
    gap: 1rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border-radius: 10px;
    color: var(--text);
    transition: background 0.15s ease;
  }
  a:hover {
    color: var(--text);
    background: var(--accent-soft);
  }
  a:hover .link-arrow :global(.icon) {
    transform: translateX(3px);
  }
  .ql-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .ql-title {
    font-weight: 700;
  }
  .ql-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .ql-cta {
    margin-top: 0.4rem;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
    li:nth-child(3) {
      border-left: 0;
    }
    li:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 520px) {
    ul {
      grid-template-columns: 1fr;
    }
    li + li {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
