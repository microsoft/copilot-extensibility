---
/**
 * SectionHeader — shared heading row used by the content sections:
 * title (+ optional subtitle) on the left and an optional "View all" link on the right.
 */
import type { SectionHeading } from '../types/config';
import Icon from './Icon.astro';
import { linkAttrs, resolveUrl } from '../utils/url';

interface Props {
  heading: SectionHeading;
}

const { heading } = Astro.props;
const headingId = `${heading.id}-title`;
---

<div class="section-header">
  <div>
    <h2 id={headingId} class="section-title">{heading.title}</h2>
    {heading.subtitle && <p class="section-subtitle">{heading.subtitle}</p>}
  </div>
  {
    heading.viewAll && (
      <a
        class="link-arrow section-view-all"
        href={resolveUrl(heading.viewAll.url)}
        {...linkAttrs(heading.viewAll.url, heading.viewAll.external)}
      >
        {heading.viewAll.label}
        <Icon name="arrow-right" size={14} />
      </a>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .section-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .section-subtitle {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .section-view-all {
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>
