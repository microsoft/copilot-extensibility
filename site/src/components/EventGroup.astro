---
/**
 * EventGroup — renders one group of events/communities inside a card.
 * Used twice by `CommunityEvents.astro`: once for first-party events and once for community events.
 */
import type { EventGroup as EventGroupConfig } from '../types/config';
import Icon from './Icon.astro';
import { formatEventDate, isIsoDate, prepareEvents } from '../utils/dates';
import { linkAttrs, resolveUrl } from '../utils/url';

interface Props {
  group: EventGroupConfig;
  /** Value of the `data-kind` attribute, useful for styling/analytics ("first-party" | "community"). */
  kind: string;
}

const { group, kind } = Astro.props;
const items = prepareEvents(group.items, { hidePast: group.hidePast, sortByDate: group.sortByDate });
---

<div class="card event-group" data-kind={kind}>
  <div class="group-header">
    <h3>{group.title}</h3>
    {
      group.viewAll && (
        <a class="link-arrow" href={resolveUrl(group.viewAll.url)} {...linkAttrs(group.viewAll.url, group.viewAll.external)}>
          {group.viewAll.label}
          <Icon name="arrow-right" size={14} />
        </a>
      )
    }
  </div>

  {
    items.length ? (
      <ul class="event-list">
        {items.map((item) => {
          const when = formatEventDate(item);
          return (
            <li class={`event accent-${item.accent}`}>
              <span class="icon-tile event-icon">
                <Icon name={item.icon} size={20} />
              </span>
              <div class="event-body">
                <h4 title={item.organizer ? `Organized by ${item.organizer}` : undefined}>{item.title}</h4>
                <p>{item.description}</p>
              </div>
              <div class="event-meta">
                {when && (isIsoDate(item.date) ? <time datetime={item.date}>{when}</time> : <span class="event-when">{when}</span>)}
                <a class="link-arrow" href={resolveUrl(item.link.url)} {...linkAttrs(item.link.url, item.link.external)}>
                  {item.link.label}
                  <Icon name="arrow-right" size={14} />
                </a>
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="empty">No upcoming events right now — check back soon.</p>
    )
  }

  {
    group.footerLink && (
      <a class="link-arrow group-footer" href={resolveUrl(group.footerLink.url)} {...linkAttrs(group.footerLink.url, group.footerLink.external)}>
        {group.footerLink.label}
        <Icon name="arrow-right" size={14} />
      </a>
    )
  }
</div>

<style>
  .event-group {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.25rem;
  }
  .group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  h3 {
    margin: 0;
    font-size: 0.95rem;
  }
  .event-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .event {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9rem;
    align-items: center;
    padding: 0.8rem 0;
  }
  .event + .event {
    border-top: 1px solid var(--border);
  }
  .event-icon {
    width: 38px;
    height: 38px;
  }
  h4 {
    margin: 0;
    font-size: 0.9rem;
  }
  p {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .event-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    text-align: right;
    white-space: nowrap;
  }
  time,
  .event-when {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
  }
  .event-meta .link-arrow {
    font-size: 0.8rem;
  }
  .group-footer {
    margin-top: auto;
    padding-top: 0.6rem;
  }
  .empty {
    padding: 1rem 0;
  }

  @media (max-width: 520px) {
    .event {
      grid-template-columns: auto 1fr;
    }
    .event-meta {
      grid-column: 2;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }
  }
</style>
