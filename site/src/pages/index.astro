---
/**
 * Home / landing page.
 * This file only composes components: every block of content is a component that receives
 * its own JSON configuration from `src/data/`. Re-order, remove or duplicate blocks here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import QuickLinks from '../components/QuickLinks.astro';
import FeaturedContent from '../components/FeaturedContent.astro';
import Videos from '../components/Videos.astro';
import Technologies from '../components/Technologies.astro';
import LearningPaths from '../components/LearningPaths.astro';
import CommunityEvents from '../components/CommunityEvents.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Team from '../components/Team.astro';
import Footer from '../components/Footer.astro';

import type {
  CommunityEventsConfig,
  EcosystemConfig,
  FeaturedContentConfig,
  HeroConfig,
  LearningPathsConfig,
  NavigationConfig,
  QuickLinksConfig,
  TeamConfig,
  TechnologiesConfig,
  VideosConfig,
} from '../types/config';
import navigationJson from '../data/navigation.json';
import heroJson from '../data/hero.json';
import quickLinksJson from '../data/quick-links.json';
import featuredJson from '../data/featured-content.json';
import videoJson from '../data/video.json';
import technologiesJson from '../data/technologies.json';
import learningPathsJson from '../data/learning-paths.json';
import communityEventsJson from '../data/community-events.json';
import ecosystemJson from '../data/ecosystem.json';
import teamJson from '../data/team.json';
import { buildSearchIndex } from '../utils/search';
import { parseFeaturedContentType } from '../types/config';

// Typed views over the JSON files: `astro check` fails if a JSON file doesn't match its contract.
const navigation: NavigationConfig = navigationJson;
const hero: HeroConfig = heroJson;
const quickLinks: QuickLinksConfig = quickLinksJson;
const featured: FeaturedContentConfig = {
  ...featuredJson,
  items: featuredJson.items.map((item) => ({ ...item, type: parseFeaturedContentType(item.type) })),
};
const videos: VideosConfig = videoJson;
const technologies: TechnologiesConfig = technologiesJson;
const learningPaths: LearningPathsConfig = learningPathsJson;
const events: CommunityEventsConfig = communityEventsJson;
const ecosystem: EcosystemConfig = ecosystemJson;
const team: TeamConfig = teamJson;

const searchIndex = buildSearchIndex({ navigation, quickLinks, featured, technologies, learningPaths, events, videos }); // , ecosystem
---

<BaseLayout>
  <Header config={navigation.header} searchIndex={searchIndex} />
  <main id="main">
    <Hero config={hero} />
    <QuickLinks config={quickLinks} />
    <FeaturedContent config={featured} />
    <Videos config={videos} />
    <Technologies config={technologies} />
    <LearningPaths config={learningPaths} />
    <CommunityEvents config={events} />
    <!--<Ecosystem config={ecosystem} />-->
    <Team config={team} />
  </main>
  <Footer config={navigation.footer} />
</BaseLayout>
